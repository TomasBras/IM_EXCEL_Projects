  <state id="gestures[gestures][insertcolumn]-final">
    <onentry>
      <log label="[gestures[gestures][insertcolumn]-final]" expr="READY" />
      <commons:var name="newExtensionNotification" expr="${mmi:newExtensionNotificationF2(contextId, 'FUSION', 'IM', mmi:newRequestId(contextId), null, data1, '[FUSION][INSERT_COLUMN]')}" />
      <send event="INSERT_COLUMN" target="IM" targettype="MC" namelist="newExtensionNotification" />
    </onentry>
    <transition target="main" />
  </state>
  <state id="sgestures[gestures][insertcolumn]-speech[speech][inserir_colunas]">
