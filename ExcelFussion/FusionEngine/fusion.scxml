    <transition target="gestures[gestures][calculateaverage]-final" event="timeout-sgestures[gestures][calculateaverage]" />
    <transition target="sgestures[gestures][calculateaverage]-speech[speech][calcular_media]" event="[SPEECH][CALCULAR_MEDIA]" />
    <onexit>
      <cancel sendid="state1-timer-sgestures[gestures][calculateaverage]" />
    </onexit>
  </state>
  <state id="gestures[gestures][calculateaverage]-final">
    <onentry>
      <log label="[gestures[gestures][calculateaverage]-final]" expr="READY" />
      <commons:var name="newExtensionNotification" expr="${mmi:newExtensionNotificationF2(contextId, 'FUSION', 'IM', mmi:newRequestId(contextId), null, data1, '[FUSION][CALCULATE_AVERAGE]')}" />
      <send event="CALCULATE_AVERAGE" target="IM" targettype="MC" namelist="newExtensionNotification" />
    </onentry>
    <transition target="main" />
  </state>
  <state id="sgestures[gestures][calculateaverage]-speech[speech][calcular_media]">
    <onentry>
      <log label="[sgestures[gestures][calculateaverage]-speech[speech][calcular_media]]" expr="READY" />
