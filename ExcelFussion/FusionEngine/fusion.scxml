    <transition target="sgestures[gestures][studentsapproved]-speech[speech][destacar_aprovados_reprovados]" event="[SPEECH][DESTACAR_APROVADOS_REPROVADOS]" />
    <transition target="sgestures[gestures][studentsapproved]-speech[speech][inserir_colunas]" event="[SPEECH][INSERIR_COLUNAS]" />
    <onexit>
