      <log label="[sgestures[gestures][insertcolumn]-speech[speech][inserir_colunas]]" expr="READY" />
      <assign name="data2" expr="${_eventdata.data}" />
      <commons:var name="newExtensionNotification" expr="${mmi:newExtensionNotificationF(contextId, 'FUSION', 'IM', mmi:newRequestId(contextId), null, data1,data2, '[FUSION][INSERT_COLUMN]')}" />
      <send event="INSERT_COLUMN" target="IM" targettype="MC" namelist="newExtensionNotification" />
    </onentry>
    <transition target="main" />
  </state>

  <state id="sgestures[gestures][insertcolumn]-speech[speech][melhoria_possivel]">
