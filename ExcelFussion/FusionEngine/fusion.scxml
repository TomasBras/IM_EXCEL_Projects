      <send event="CLOSE_EXCEL" target="IM" targettype="MC" namelist="newExtensionNotification" />
    </onentry>
    <transition target="confirm[close_excel]" />
  </state>
  <state id="sspeech[speech][destacar_aprovados_reprovados]">
